ACADEMY_API_HOST=127.0.0.1
ACADEMY_API_PORT=8000
ACADEMY_LOG_LEVEL=INFO
ACADEMY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACADEMY_MAX_JSON_BODY_BYTES=16384
ACADEMY_ENABLE_DB_APIS=0
ACADEMY_COOKIE_SECURE=0
ACADEMY_SESSION_COOKIE=academy_session
ACADEMY_CSRF_COOKIE=academy_csrf
ACADEMY_SESSION_TTL_MINUTES=480
# Phase 11-4-B SEC-05: a session unused this long is revoked server-side (401 SESSION_IDLE_EXPIRED).
# 1..ACADEMY_SESSION_TTL_MINUTES; 0 (no idle limit) is rejected at startup. The 8-hour TTL above still applies.
ACADEMY_SESSION_IDLE_MINUTES=60
ACADEMY_LOGIN_ATTEMPT_LIMIT=5
ACADEMY_LOGIN_WINDOW_SECONDS=900
# Phase 11-2-B-2: failures per address over all accounts / per account over all addresses (0 = off)
ACADEMY_LOGIN_IP_ATTEMPT_LIMIT=20
ACADEMY_LOGIN_ACCOUNT_ATTEMPT_LIMIT=20
# Reverse proxies whose X-Forwarded-For is trusted (IPs / CIDRs, comma separated). Empty = ignore
# the header. Set only to the deployment's real proxy range (Phase 11-5); never 0.0.0.0/0.
ACADEMY_TRUSTED_PROXIES=
# Deployment client address sources (docs/deployment/phase11_5_security_deployment_guide.md).
# Single-address header the outer edge overwrites, e.g. cf-connecting-ip. Empty = off.
ACADEMY_CLIENT_IP_HEADER=
# Shared secret our front proxy (Vercel rewrite) adds; >= 32 chars. Empty = off. Never commit it.
ACADEMY_EDGE_SECRET=
ACADEMY_EDGE_SECRET_HEADER=x-academy-edge-secret
# Admin-only GET /api/auth/client-address for the deployment check; keep 0 otherwise.
ACADEMY_PROXY_DIAGNOSTICS=0
# /docs, /redoc, /openapi.json (1 = published). Off unless set.
ACADEMY_API_DOCS=0
# Strict-Transport-Security max-age in seconds (HTTPS deployments only). 0 = no header.
ACADEMY_HSTS_MAX_AGE=0

# Run mode (Phase 11-4-B SEC-04): development | test | production
#   development: loopback API host + the local dev DB only (this file's default).
#   test:        loopback + the isolated test DB on 127.0.0.1:55432 only (integration tests).
#   production:  deployment. The app refuses to start unless ACADEMY_ENABLE_DB_APIS=1,
#                ACADEMY_COOKIE_SECURE=1, exact https:// CORS origins (no localhost/*),
#                no /0 in ACADEMY_TRUSTED_PROXIES, test switches unset, and a PostgreSQL URL
#                with ?sslmode=require (or verify-ca/verify-full) that is not a local dev/test DB.
#                See docs/deployment/phase11_5_security_deployment_guide.md.
# Development DB. This is never a valid target for destructive integration tests.
ACADEMY_DB_MODE=development
ACADEMY_DB_TEST_MODE=0
ACADEMY_DEV_DB_PASSWORD=replace-with-a-local-secret
ACADEMY_TEST_DB_PASSWORD=replace-with-a-different-local-secret
ACADEMY_DATABASE_URL=postgresql+psycopg://academy_dev:<url-encoded-password>@127.0.0.1:55431/academy_learningops_dev

# Integration tests override the three values above with:
# ACADEMY_DB_MODE=test
# ACADEMY_DB_TEST_MODE=1
# ACADEMY_DATABASE_URL=postgresql+psycopg://academy_test:<url-encoded-password>@127.0.0.1:55432/academy_learningops_test

# Neon deployment (Phase 11-5-A, docs/deployment/phase11_5_a_neon_guide.md). Never commit real values.
# The Direct (non "-pooler") endpoint is used for both Alembic and the app; keep sslmode=require.
# ACADEMY_DB_MODE=production
# ACADEMY_DATABASE_URL=postgresql+psycopg://<role>:<url-encoded-password>@<endpoint-id>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require

# Demo seed (backend/scripts/seed_demo.py) — only in the shell that runs it, never on Render.
# ACADEMY_SEED_DEMO=1
# ACADEMY_SEED_TARGET_HOST=<endpoint-id>.<region>.aws.neon.tech
# ACADEMY_SEED_ADMIN_PASSWORD=<12+ characters>
# ACADEMY_SEED_TEACHER_PASSWORD=<12+ characters, different>
# ACADEMY_SEED_ASSISTANT_PASSWORD=<12+ characters, different>

