        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    STUDENT {\n        BIGINT id PK\n        VARCHAR name\n        VARCHAR school_name\n        VARCHAR parent_name\n        VARCHAR parent_email\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    CLASSROOM {\n        BIGINT id PK\n        VARCHAR name\n        VARCHAR class_type\n        BOOLEAN is_active\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    ENROLLMENT {\n        BIGINT id PK\n        BIGINT student_id FK\n        BIGINT classroom_id FK\n        VARCHAR status\n        DATE enrolled_at\n        DATE ended_at\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    LESSON {\n        BIGINT id PK\n        BIGINT classroom_id FK\n        DATE lesson_date\n        VARCHAR exam_round\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    LESSON_RESULT {\n        BIGINT id PK\n        BIGINT lesson_id FK\n        BIGINT enrollment_id FK\n        VARCHAR attendance_status\n        VARCHAR prework_grade\n        VARCHAR weekly_assignment_grade\n        SMALLINT correct_count\n        SMALLINT total_count\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    MAKEUP_REQUEST {\n        BIGINT id PK\n        BIGINT lesson_result_id FK\n        VARCHAR status\n        TIMESTAMPTZ requested_at\n        TIMESTAMPTZ completed_at\n        VARCHAR cancel_reason\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    MESSAGE_TEMPLATE {\n        BIGINT id PK\n        VARCHAR class_type\n        TEXT subject_template\n        TEXT body_template\n        BOOLEAN is_active\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    MESSAGE_DRAFT {\n        BIGINT id PK\n        BIGINT lesson_result_id FK\n        BIGINT template_id FK\n        TEXT subject\n        TEXT body\n        VARCHAR draft_status\n        TIMESTAMPTZ generated_at\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    DELIVERY_JOB {\n        BIGINT id PK\n        BIGINT message_draft_id FK\n        VARCHAR recipient_email\n        VARCHAR status\n        TIMESTAMPTZ requested_at\n        TIMESTAMPTZ processed_at\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    DELIVERY_ATTEMPT {\n        BIGINT id PK\n        BIGINT delivery_job_id FK\n        INTEGER attempt_no\n        VARCHAR attempt_status\n        TEXT error_message\n        TIMESTAMPTZ attempted_at\n    }\n\n    IMPORT_JOB {\n        BIGINT id PK\n        VARCHAR source_type\n        VARCHAR source_file_name\n        VARCHAR file_hash\n        INTEGER total_rows\n        INTEGER success_rows\n        INTEGER failed_rows\n        VARCHAR status\n        TIMESTAMPTZ started_at\n        TIMESTAMPTZ finished_at\n        TIMESTAMPTZ created_at\n    }\n\n    IMPORT_ROW {\n        BIGINT id PK\n        BIGINT import_job_id FK\n        BIGINT lesson_result_id FK\n        INTEGER row_number\n        VARCHAR row_hash\n        VARCHAR processing_result\n        VARCHAR enrollment_action\n        TIMESTAMPTZ created_at\n    }\n\n    IMPORT_ERROR {\n        BIGINT id PK\n        BIGINT import_row_id FK\n        VARCHAR field_name\n        VARCHAR error_code\n        TEXT error_message\n        TIMESTAMPTZ created_at\n    }\n\n\n    STUDENT ||--o{ ENROLLMENT : enrolls\n\n    CLASSROOM ||--o{ ENROLLMENT : contains\n\n    CLASSROOM ||--o{ LESSON : has\n\n\n    ENROLLMENT ||--o{ LESSON_RESULT : receives\n\n    LESSON ||--o{ LESSON_RESULT : produces\n\n\n    LESSON_RESULT ||--o{ MAKEUP_REQUEST : generates\n\n\n    LESSON_RESULT ||--o{ MESSAGE_DRAFT : generates\n\n    MESSAGE_TEMPLATE ||--o{ MESSAGE_DRAFT : applies_to\n\n\n    MESSAGE_DRAFT ||--o{ DELIVERY_JOB : creates\n\n    DELIVERY_JOB ||--o{ DELIVERY_ATTEMPT : attempts\n\n\n    IMPORT_JOB ||--o{ IMPORT_ROW : contains\n\n    LESSON_RESULT o|--o{ IMPORT_ROW : mapped_from\n\n    IMPORT_ROW ||--o{ IMPORT_ERROR : has&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="H4pOhiQWNJHBTERGoYFk-1">
